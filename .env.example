# Supabase — public values (safe in the browser, access is enforced by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Supabase — SERVER ONLY. Used by the invitation and password-recovery Server Actions and by
# the seed script. Never exposed to the client, never committed. Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Public URL of the app (auth redirects, invitation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mail sent by the app itself — the invitation (D75) and the password-recovery code (D78).
# Server only, never exposed. Without RESEND_API_KEY both fall back to Supabase Auth: the
# invitation cannot then reach an address that already has an account (it sends a sign-in code
# instead of naming the boat), and the recovery code goes out through Supabase's built-in SMTP,
# which is capped at a few messages an hour for the whole project.
# The key is a Resend API key (Resend → API Keys); the sender must be on the verified domain.
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=Xaman <noreply@xaman.boats>

# Delivery events for the e-mails the app sends (D79) — Resend → Webhooks → Signing Secret.
# Without it the endpoint /api/webhooks/resend refuses every event and the Membres screen falls
# back to asking the provider itself, a minute later. Server only, never exposed.
RESEND_WEBHOOK_SECRET=<whsec_...>

# The inbox (D91, D92): a photographed receipt or an attachment mailed to the boat's address is
# read and arrives pre-filled on « À valider ». Without this key the reading is local — the PDF's
# text layer or Tesseract on a photo, then a set of rules — and costs nothing (D92). With it,
# Claude reads instead, and the local reader takes over if the call fails. Server only, never
# exposed. Optional.
ANTHROPIC_API_KEY=<sk-ant-...>

# The receiving domain of the boats' addresses (`<slug>-<token>@<domain>`), e.g. carnet.xaman.boats.
# Resend → Domains → add the domain with « Receiving » enabled and its MX record, then Webhooks →
# the same endpoint as above with the event `email.received`. Unset = no address is shown.
INBOUND_EMAIL_DOMAIN=<carnet.xaman.boats>
