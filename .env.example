# Supabase — public values (safe in the browser, access is enforced by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Supabase — SERVER ONLY. Used by the invitation Server Action and the seed script.
# Never exposed to the client, never committed. Found in Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Public URL of the app (auth redirects, invitation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
