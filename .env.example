# Supabase — public values (safe in the browser, access is enforced by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Supabase — SERVER ONLY. Used by the invitation Server Action and the seed script.
# Never exposed to the client, never committed. Found in Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Public URL of the app (auth redirects, invitation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mail sent by the app itself — the invitation (D75). Server only, never exposed.
# Without RESEND_API_KEY the invitation falls back to Supabase Auth, which cannot invite an
# address that already has an account: it sends a sign-in code instead of naming the boat.
# The key is a Resend API key (Resend → API Keys); the sender must be on the verified domain.
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=Xaman <noreply@xaman.boats>
