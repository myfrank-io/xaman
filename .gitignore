# Dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/

# Next.js
.next/
out/
next-env.d.ts

# Build
build/
dist/
*.tsbuildinfo

# Environment (secrets never in the repo; .env.example documents the names)
.env
.env*.local
!.env.example

# Vercel
.vercel

# Supabase (local CLI state)
supabase/.temp
supabase/.branches

# PWA / service worker (generated by Serwist)
public/sw.js
public/sw.js.map
public/swe-worker-*.js

# Tests
coverage/
test-results/
playwright-report/
playwright/.cache/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / IDE
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.pem

# Agent worktrees (Claude Code isolation)
.claude/worktrees/

# Throwaway browser scripts. Playwright is only resolvable from the repo root, so a one-off
# script that drives a page has to be written here — and then it sits next to real source
# waiting to be committed by accident, or to fail `format:check`. Name them `zz-*.mjs`.
zz-*.mjs
